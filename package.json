{
  "name": "math-quest",
  "version": "3.3.0",
  "private": true,
  "description": "Math Quest multi-platform educational game",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "audit:questions": "node scripts/audit-questions.cjs",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "android:add": "npm run build && npx cap add android && npm run android:icons",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --linux AppImage tar.gz",
    "test": "node --test tests/*.test.cjs",
    "android:icons": "npx capacitor-assets generate --android",
    "audit:curriculum": "node scripts/audit-k12-pathway.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "@capacitor/assets": "3.0.5"
  },
  "build": {
    "appId": "org.mathquest.educational",
    "productName": "Math Quest",
    "directories": {
      "output": "release"
    },
    "files": [
      "www/**/*",
      "desktop/main.cjs",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Education",
      "icon": "icons"
    },
    "asar": true
  }
}
